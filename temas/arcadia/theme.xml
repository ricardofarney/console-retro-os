<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tema: Arcádia (versão 0.2 — estilo "colorido por console", ver docs/DESIGN.md)
  Projeto: Arcádia — Console de Jogos Retrô (KINHANK Super Console X2 Pro)
  Compatível com o EmulationStation da linha Batocera (EmuELEC e RetroBat).
  Artes geradas por ferramentas/tema/gerar-arte.ps1 — não editar as imagens à mão.
  Cores por console: cores/<sistema>.xml (geradas pelo mesmo script).
-->
<theme defaultView="detailed">
  <formatVersion>7</formatVersion>

  <variables>
    <corFundo>F4F1EA</corFundo>
    <corTexto>2C2C2A</corTexto>
    <corTexto2>5F5E5A</corTexto2>
  </variables>

  <!-- ===================== Tela inicial: grade de consoles ===================== -->
  <view name="system">
    <image name="background" extra="static">
      <pos>0 0</pos>
      <size>1 1</size>
      <path>./arte/branco.png</path>
      <color>${corFundo}</color>
      <zIndex>1</zIndex>
    </image>

    <text name="marca" extra="static">
      <text>Arcádia</text>
      <pos>0.045 0.05</pos>
      <size>0.5 0.08</size>
      <fontSize>0.062</fontSize>
      <color>${corTexto}</color>
      <alignment>left</alignment>
      <zIndex>50</zIndex>
    </text>

    <text name="subtitulo" extra="static">
      <text>Escolha um console</text>
      <pos>0.046 0.125</pos>
      <size>0.5 0.04</size>
      <fontSize>0.028</fontSize>
      <color>${corTexto2}</color>
      <alignment>left</alignment>
      <zIndex>50</zIndex>
    </text>

    <imagegrid name="imagegrid">
      <pos>0.035 0.19</pos>
      <size>0.93 0.73</size>
      <autoLayout>4 0</autoLayout>
      <cellProportion>1.6</cellProportion>
      <margin>0.014 0.024</margin>
      <padding>0.006 0.012 0.006 0.012</padding>
      <scrollDirection>vertical</scrollDirection>
      <centerSelection>false</centerSelection>
      <scrollLoop>false</scrollLoop>
      <animateSelection>false</animateSelection>
      <scrollbarColor>2C2C2A30</scrollbarColor>
      <scrollbarSize>0.004</scrollbarSize>
      <zIndex>20</zIndex>
      <itemTemplate>
        <container>
          <scale>1</scale>
          <storyboard event="activate">
            <animation property="scale" to="1.06" duration="150" mode="easeOut"/>
          </storyboard>
          <storyboard event="deactivate">
            <animation property="scale" to="1" duration="200" mode="easeOut"/>
          </storyboard>
          <!-- sombra -->
          <image name="sombra">
            <path>./arte/sombra.png</path>
            <pos>0.5 0.53</pos>
            <origin>0.5 0.5</origin>
            <size>1.05 1.09</size>
            <color>FFFFFF70</color>
            <zIndex>1</zIndex>
          </image>
          <!-- card do console (cor + nome) -->
          <image name="cartao">
            <path>{system:logo}</path>
            <pos>0.5 0.5</pos>
            <origin>0.5 0.5</origin>
            <maxSize>1 1</maxSize>
            <linearSmooth>true</linearSmooth>
            <zIndex>2</zIndex>
          </image>
          <!-- console sem card: nome em texto -->
          <text name="nomeAlternativo">
            <visible>!exists({system:logo})</visible>
            <text>{system:fullName}</text>
            <pos>0 0</pos>
            <size>1 1</size>
            <alignment>center</alignment>
            <color>${corTexto}</color>
            <fontSize>0.03</fontSize>
            <zIndex>3</zIndex>
          </text>
          <!-- quantidade de jogos -->
          <text name="quantidade1">
            <visible>{system:total} == 1</visible>
            <text>1 jogo</text>
            <pos>0.45 0.07</pos>
            <size>0.48 0.14</size>
            <alignment>right</alignment>
            <verticalAlignment>top</verticalAlignment>
            <color>FFFFFFE6</color>
            <fontSize>0.022</fontSize>
            <zIndex>4</zIndex>
          </text>
          <text name="quantidade">
            <!-- não usar "!=" : derruba o leitor de expressões do EmulationStation -->
            <visible>!({system:total} == 1)</visible>
            <text>{system:total} jogos</text>
            <pos>0.45 0.07</pos>
            <size>0.48 0.14</size>
            <alignment>right</alignment>
            <verticalAlignment>top</verticalAlignment>
            <color>FFFFFFE6</color>
            <fontSize>0.022</fontSize>
            <zIndex>4</zIndex>
          </text>
          <!-- console favoritado (função do arcadia-emulationstation) -->
          <text name="estrela">
            <visible>{system:favorite}</visible>
            <text>&#xF005;</text>
            <pos>0.84 0.7</pos>
            <size>0.12 0.24</size>
            <alignment>center</alignment>
            <color>FFFFFF</color>
            <fontSize>0.036</fontSize>
            <zIndex>4</zIndex>
          </text>
        </container>
      </itemTemplate>
    </imagegrid>

    <gridtile name="default">
      <padding>0 0</padding>
      <backgroundColor>00000000</backgroundColor>
      <backgroundCenterColor>00000000</backgroundCenterColor>
      <backgroundEdgeColor>00000000</backgroundEdgeColor>
    </gridtile>
    <gridtile name="selected">
      <padding>0 0</padding>
      <backgroundColor>00000000</backgroundColor>
      <backgroundCenterColor>00000000</backgroundCenterColor>
      <backgroundEdgeColor>00000000</backgroundEdgeColor>
    </gridtile>

    <!-- logotipo do console = card (usado pela grade via {system:logo} e pelo carrossel, se o ES não tiver grade) -->
    <image name="logo">
      <path>./logos/${system.theme}.png</path>
      <linearSmooth>true</linearSmooth>
    </image>

    <text name="logoText">
      <fontSize>0.04</fontSize>
      <color>${corTexto}</color>
      <forceUppercase>false</forceUppercase>
    </text>

    <!-- a quantidade já aparece em cada card -->
    <text name="systemInfo">
      <visible>false</visible>
    </text>

    <helpsystem name="help">
      <pos>0.045 0.945</pos>
      <textColor>${corTexto2}</textColor>
      <iconColor>${corTexto2}</iconColor>
      <fontSize>0.024</fontSize>
    </helpsystem>
  </view>

  <!-- ===================== Listas de jogos ===================== -->
  <view name="basic,detailed,video">
    <!-- fundo no tom claro do console (cor em cores/<sistema>.xml) -->
    <image name="background" extra="static">
      <pos>0 0</pos>
      <size>1 1</size>
      <path>./arte/branco.png</path>
      <color>${corFundo}</color>
      <zIndex>1</zIndex>
    </image>

    <!-- faixa superior na cor do console -->
    <image name="faixa" extra="true">
      <pos>0 0</pos>
      <size>1 0.12</size>
      <path>./arte/branco.png</path>
      <color>888780FF</color>
      <zIndex>2</zIndex>
    </image>

    <image name="logo">
      <pos>0.04 0.06</pos>
      <origin>0 0.5</origin>
      <maxSize>0.45 0.09</maxSize>
      <path>./logos/claro/${system.theme}.png</path>
      <linearSmooth>true</linearSmooth>
      <zIndex>50</zIndex>
    </image>

    <text name="logoText">
      <pos>0.04 0.02</pos>
      <size>0.6 0.08</size>
      <fontSize>0.045</fontSize>
      <color>FFFFFF</color>
      <alignment>left</alignment>
      <zIndex>50</zIndex>
    </text>

    <!-- ★ favoritos primeiro (FavoritesFirst), depois A a Z; gênero ao lado do nome -->
    <textlist name="gamelist">
      <pos>0.035 0.155</pos>
      <size>0.47 0.76</size>
      <fontSize>0.031</fontSize>
      <lineSpacing>1.9</lineSpacing>
      <alignment>left</alignment>
      <horizontalMargin>0.012</horizontalMargin>
      <selectorColor>888780FF</selectorColor>
      <selectedColor>FFFFFFFF</selectedColor>
      <primaryColor>${corTexto}FF</primaryColor>
      <secondaryColor>888780FF</secondaryColor>
      <scrollbarColor>2C2C2A40</scrollbarColor>
      <zIndex>40</zIndex>
      <itemTemplate>
        <!-- barra de seleção (o modelo por linha substitui a barra padrão) -->
        <rectangle name="selecao">
          <pos>0 0.06</pos>
          <size>1 0.88</size>
          <color>2C2C2A00</color>
          <roundCorners>0.3</roundCorners>
          <storyboard event="activate"><animation property="color" to="2C2C2AFF" duration="80"/></storyboard>
          <storyboard event="deactivate"><animation property="color" to="2C2C2A00" duration="80"/></storyboard>
        </rectangle>
        <!-- ★ jogo favorito -->
        <text name="estrela">
          <visible>{game:favorite}</visible>
          <text>&#xF005;</text>
          <pos>0.015 0</pos>
          <size>0.05 1</size>
          <alignment>center</alignment>
          <verticalAlignment>center</verticalAlignment>
          <color>C9A227</color>
          <fontSize>0.024</fontSize>
        </text>
        <text name="nome">
          <text>{game:name}</text>
          <pos>0.07 0</pos>
          <size>0.61 1</size>
          <verticalAlignment>center</verticalAlignment>
          <color>${corTexto}</color>
          <fontSize>0.031</fontSize>
          <storyboard event="activate"><animation property="color" to="FFFFFFFF" duration="1"/></storyboard>
          <storyboard event="deactivate"><animation property="color" to="${corTexto}FF" duration="1"/></storyboard>
        </text>
        <text name="genero">
          <text>{game:genre}</text>
          <pos>0.68 0</pos>
          <size>0.3 1</size>
          <alignment>right</alignment>
          <verticalAlignment>center</verticalAlignment>
          <color>${corTexto2}</color>
          <fontSize>0.021</fontSize>
          <storyboard event="activate"><animation property="color" to="FFFFFFE0" duration="1"/></storyboard>
          <storyboard event="deactivate"><animation property="color" to="${corTexto2}FF" duration="1"/></storyboard>
        </text>
      </itemTemplate>
    </textlist>

    <helpsystem name="help">
      <pos>0.04 0.945</pos>
      <textColor>${corTexto2}</textColor>
      <iconColor>${corTexto2}</iconColor>
      <fontSize>0.024</fontSize>
    </helpsystem>
  </view>

  <view name="detailed,video">
    <!-- painel do jogo -->
    <image name="painel" extra="true">
      <pos>0.53 0.155</pos>
      <size>0.435 0.76</size>
      <path>./arte/branco.png</path>
      <color>FFFFFFD8</color>
      <roundCorners>0.03</roundCorners>
      <zIndex>5</zIndex>
    </image>

    <image name="md_image">
      <pos>0.7475 0.335</pos>
      <origin>0.5 0.5</origin>
      <maxSize>0.38 0.3</maxSize>
      <roundCorners>0.03</roundCorners>
      <!-- jogo sem capa: mostra o card do console -->
      <default>./logos/${system.theme}.png</default>
      <zIndex>30</zIndex>
    </image>

    <video name="md_video">
      <pos>0.7475 0.335</pos>
      <origin>0.5 0.5</origin>
      <maxSize>0.38 0.3</maxSize>
      <zIndex>31</zIndex>
    </video>

    <text name="md_name">
      <pos>0.555 0.505</pos>
      <size>0.385 0.055</size>
      <fontSize>0.036</fontSize>
      <color>${corTexto}</color>
      <alignment>left</alignment>
      <zIndex>30</zIndex>
    </text>

    <text name="md_lbl_genre"><pos>0.555 0.57</pos><size>0.11 0.034</size><fontSize>0.022</fontSize><color>${corTexto2}</color><zIndex>30</zIndex></text>
    <text name="md_genre"><pos>0.665 0.57</pos><size>0.27 0.034</size><fontSize>0.022</fontSize><color>${corTexto}</color><zIndex>30</zIndex></text>
    <text name="md_lbl_players"><pos>0.555 0.606</pos><size>0.11 0.034</size><fontSize>0.022</fontSize><color>${corTexto2}</color><zIndex>30</zIndex></text>
    <text name="md_players"><pos>0.665 0.606</pos><size>0.27 0.034</size><fontSize>0.022</fontSize><color>${corTexto}</color><zIndex>30</zIndex></text>
    <!-- Lançamento: só aparece quando o jogo tem data (sem data, nada de "Desconhecido");
         fica por último para não deixar buraco entre as linhas -->
    <text name="md_lbl_releasedate"><visible>false</visible></text>
    <datetime name="md_releasedate"><visible>false</visible></datetime>
    <text name="arcadia_lbl_ano" extra="true"><text>Lançamento:</text><pos>0.555 0.642</pos><size>0.11 0.034</size><fontSize>0.022</fontSize><color>${corTexto2}</color><zIndex>30</zIndex><visible>!({game:releaseyear} == "")</visible></text>
    <text name="arcadia_ano" extra="true"><text>{game:releaseyear}</text><pos>0.665 0.642</pos><size>0.27 0.034</size><fontSize>0.022</fontSize><color>${corTexto}</color><zIndex>30</zIndex><visible>!({game:releaseyear} == "")</visible></text>

    <text name="md_description">
      <pos>0.555 0.69</pos>
      <size>0.385 0.2</size>
      <fontSize>0.021</fontSize>
      <color>${corTexto2}</color>
      <alignment>left</alignment>
      <zIndex>30</zIndex>
    </text>

    <!-- itens ocultos (DESIGN.md: capa, nome, ano, gênero, jogadores e resumo) -->
    <text name="md_lbl_rating"><visible>false</visible></text>
    <rating name="md_rating"><visible>false</visible></rating>
    <text name="md_lbl_developer"><visible>false</visible></text>
    <text name="md_developer"><visible>false</visible></text>
    <text name="md_lbl_publisher"><visible>false</visible></text>
    <text name="md_publisher"><visible>false</visible></text>
    <text name="md_lbl_lastplayed"><visible>false</visible></text>
    <datetime name="md_lastplayed"><visible>false</visible></datetime>
    <text name="md_lbl_playcount"><visible>false</visible></text>
    <text name="md_playcount"><visible>false</visible></text>
  </view>

  <!-- Cores de cada console (arquivo ausente = cinza #888780, "demais consoles") -->
  <include>./cores/${system.theme}.xml</include>
</theme>
